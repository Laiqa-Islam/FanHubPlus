# ─────────────────────────────────────────────────────────────
# Fan Hub Plus — backend environment
# Copy to `.env` and fill in. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────

# API port (the Vite dev server proxies /api here)
PORT=5050

# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/fanhub)
MONGODB_URI=

# Session signing key (HS256). `openssl rand -base64 32`. Rotate to invalidate every session.
SESSION_SECRET=

# Cloudinary — media uploads (avatars, article art, member submissions)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fanhub

# Mailtrap — email verification + password reset (sandbox inbox)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM="Fan Hub Plus <no-reply@fanhubplus.app>"

# Public base URL of the frontend, used to build verification / reset links
APP_URL=http://localhost:5210

# Gemini — powers the optional AI assistant. Leave empty to hide the widget.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
